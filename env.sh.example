#!/usr/bin/env bash
# Copy to .env.sh (gitignored) and fill in values for local Terraform / Terragrunt.
#   cp env.sh.example .env.sh && source .env.sh

# Alibaba Cloud credentials (prefer RAM user / STS over root account)
export ALICLOUD_ACCESS_KEY="REPLACE_ME"
export ALICLOUD_SECRET_KEY="REPLACE_ME"
export ALICLOUD_REGION="cn-hangzhou"
# Optional: assume RAM role
# export ALICLOUD_SECURITY_TOKEN=""
# export ALICLOUD_ASSUME_ROLE_ARN=""
# export ALICLOUD_ACCOUNT_ID=""

# Terragrunt / shared inputs
export TF_VAR_account_name="demo"
export TF_VAR_project="alicloud-modules"
export TF_VAR_environment="development"
