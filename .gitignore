# Local .terraform directories
.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files (often contain secrets)
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore transient lock info files
.terraform.tfstate.lock.info
.terraform.lock.hcl

# Terraform plan output may contain sensitive values
*.tfplan
*tfplan*

# Private keys
*.pem

# Ignore user's global CLI config
terraform.rc

# Environment variable files (contain credentials)
.env.sh
*.env.sh
.env
*.env

# Tool local overrides
.tflint.hcl.local
.tfsec.yml.local
.terraform-docs.yml.local

# Terragrunt cache
.terragrunt-cache/
**/.terragrunt-cache/

# Local OCI reference clone (dev only)
_ref-oci/

# Local Terraform provider plugin cache (optional)
.plugin-cache/
